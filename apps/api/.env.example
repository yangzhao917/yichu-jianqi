NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
PUBLIC_WEB_URL="http://localhost:3000"
# 真实企业初始化配置；执行 npm run db:seed 后可用管理员手机号接收验证码登录。
ADMIN_PHONE=""
ADMIN_NAME="企业管理员"
ADMIN_EMAIL="admin@local.test"
ORGANIZATION_SLUG=""
ORGANIZATION_NAME=""
ORGANIZATION_CREDIT_CODE=""
ORGANIZATION_TAGLINE="让产品自己讲清楚。"
ORGANIZATION_DESCRIPTION="统一维护产品介绍、视频、问答资料和客户线索。"

# Production uses Alibaba Cloud Number Authentication Service (Dypnsapi) SMS authentication.
# Its SMS authentication capability is available to individual users without enterprise SMS qualifications.
# The same authentication path is used in development and production.
AUTH_MODE=aliyun
# Dypnsapi accepts either service-specific AccessKey names or the shared ALIYUN_ACCESS_KEY_* names.
ALIYUN_DYPNS_ACCESS_KEY_ID=""
ALIYUN_DYPNS_ACCESS_KEY_SECRET=""
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
ALIYUN_DYPNS_SCHEME_NAME=""
ALIYUN_DYPNS_SIGN_NAME=""
ALIYUN_DYPNS_TEMPLATE_CODE=""
# 默认模板参数只传验证码；如果所选赠送模板还声明了 min 等变量，在本地 .env 覆盖为 JSON 字符串。
ALIYUN_DYPNS_TEMPLATE_PARAM='{"code":"##code##","min":"5"}'
ALIYUN_DYPNS_REGION_ID="cn-hangzhou"
ALIYUN_DYPNS_ENDPOINT="dypnsapi.aliyuncs.com"

# Pixelle-Video adapter (https://github.com/ATH-MaaS/Pixelle-Video). Empty values intentionally leave
# media steps in waiting_configuration. The MVP never marks a video complete without worker evidence.
# Base URL of Pixelle FastAPI (the adapter calls /api/video/generate/async).
PIXELLE_VIDEO_API_URL=""
# Compatibility alias for deployments already using this name.
PIXELLE_VIDEO_URL=""
PIXELLE_VIDEO_COMMAND=""
PIXELLE_VIDEO_COMMIT=""
PIXELLE_VIDEO_WORKFLOW="museum_story_zh"
PIXELLE_FRAME_TEMPLATE="1080x1920/image_default.html"
WORKFLOW_CALLBACK_TOKEN=""
VIDEO_PROVIDER_API_KEY=""
VOICE_PROVIDER_API_KEY=""

# V0 knowledge uses OpenSearch-LLM for indexing/retrieval and DeepSeek for generation.
# PUBLIC_WEB_URL must be reachable by visitors because knowledge citations use it.
# OpenSearch receives BASE64 files under 1 MB and retrieves with chat.disable=true.
ALIYUN_OPENSEARCH_API_KEY=""
ALIYUN_OPENSEARCH_ENDPOINT=""
ALIYUN_OPENSEARCH_APP_GROUP_ID=""
ALIYUN_OPENSEARCH_TOP_N="5"
DEEPSEEK_API_KEY=""
DEEPSEEK_API_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Local V0 upload directory. Replace with object storage before production.
UPLOAD_DIR=""
