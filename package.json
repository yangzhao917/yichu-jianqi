{
  "name": "yichu-jianqi",
  "version": "0.1.0",
  "private": true,
  "description": "一触见企：面向企业销售与展会场景的 NFC 产品知识入口 MVP",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run start:dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "db:seed": "npm --prefix apps/api run db:seed",
    "db:reset": "npm --prefix apps/api run db:reset"
  },
  "engines": {
    "node": ">=20"
  }
}
